{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@kontent-ai/biome-config/base"],
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*",
      "!.output",
      "!.vinxi",
      "!.wrangler",
      "!.claude",
      "!data",
      "!public",
      "!bundle-report.html"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  }
}
