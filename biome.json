{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@kontent-ai/biome-config/base"],
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*",
      "!dist",
      "!.wrangler",
      "!.claude",
      "!data",
      "!public",
      "!src/server/worker-configuration.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "useSemanticElements": "off"
      },
      "style": {
        "noDefaultExport": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/routes/**",
        "src/app.tsx",
        "src/Document.tsx",
        "src/middleware.ts",
        "vite.config.ts",
        "vitest.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
