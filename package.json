{
  "name": "cookmark",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --write",
    "biome:lint": "biome lint",
    "local:setup": "node scripts/localSetup.ts",
    "local:preview": "node scripts/localPreview.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types src/server/worker-configuration.d.ts --config wrangler.jsonc --include-runtime=false",
    "cf:types:check": "wrangler types src/server/worker-configuration.d.ts --config wrangler.jsonc --include-runtime=false --check"
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "1.70.1",
    "@kontent-ai/biome-config": "^0.5.1",
    "@solidjs/router": "^2.0.1",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "25.9.8",
    "@vitest/ui": "^5.0.1",
    "filesystem-routing": "0.5.0",
    "jsdom": "^25.0.1",
    "solid-js": "^2.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1",
    "wrangler": "4.165.0"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.5",
    "fuse.js": "^7.5.0",
    "jose": "6.2.12",
    "photoswipe": "5.4.4"
  },
  "private": true
}
